#meld python

# Phase 2 done-when: one Python and one JavaScript region, stdout merged in
# file order. Run from the project root: meld run examples/05-t2-run.meld
@python as first {
    print("python region one")
    print("python region two")
}

@javascript as second {
    console.log("javascript region one");
    console.log("javascript region two");
}
