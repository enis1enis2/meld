#meld python

# Task: switch between Python and JavaScript blocks, then evaluate an inline Python island.
@python as setup {
    name = "Meld"
    print("hello from python")
}

@javascript as greet {
    const who = "world";
    console.log("hello from javascript: " + who);
}

# Inline expression island rendered by the containing region at run time.
print(⟦python: 2 + 3⟧)
